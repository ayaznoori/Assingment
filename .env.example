# Copy to server/.env (see README)

USE_IN_MEMORY_MONGO=true
MONGODB_URI=mongodb://127.0.0.1:27017/nxtwave_questions

PORT=5001
CLIENT_ORIGIN=http://localhost:5173

MOCK_LLM=false

# ——— OpenRouter (recommended if Gemini 503) ———
# Key: https://openrouter.ai/keys
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=google/gemini-flash-1.5-8b
# Cap output tokens. Reasoning models need more (4096+); cheap accounts: use gemini-2.0-flash-001 not nemotron.
OPENROUTER_MAX_TOKENS=4096
# Avoid reasoning-heavy free models — they fill tokens with "thinking" and return no JSON.
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Optional (OpenRouter rankings / attribution)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Question Studio

# ——— Direct Gemini ———
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# ——— Direct OpenAI ———
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
