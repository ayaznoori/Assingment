# Copy to server/.env (see README)

USE_IN_MEMORY_MONGO=true
MONGODB_URI=mongodb://127.0.0.1:27017/nxtwave_questions

PORT=5001
CLIENT_ORIGIN=http://localhost:5173

# Demo mode — no API calls (only works well with sample-reading-material.md)
MOCK_LLM=false

# ——— Gemini (recommended) — get key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ——— OpenAI (optional alternative) ———
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
