# Copy to server/.env (see README)

# MongoDB — use docker compose, Atlas, or in-memory (no install)
USE_IN_MEMORY_MONGO=true
MONGODB_URI=mongodb://127.0.0.1:27017/nxtwave_questions

# Server
PORT=5001
CLIENT_ORIGIN=http://localhost:5173

# LLM — set MOCK_LLM=true to run without any API key (demo / UI testing)
MOCK_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
